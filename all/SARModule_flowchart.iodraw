<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="SARModule-流程图">
    <mxGraphModel dx="900" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== 标题 ===== -->
        <mxCell id="title" value="StripAttentionRefinementModule (SARModule) 数据流图" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="180" y="10" width="540" height="30" as="geometry" />
        </mxCell>

        <!-- ===== 输入 ===== -->
        <mxCell id="input" value="输入特征图 x&#xa;[B, C, H, W]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="55" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- ===== H方向条带注意力容器 ===== -->
        <mxCell id="h_container" value="H方向条带注意力 (Strip Attention H)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;fontColor=#333333;dashed=1;dashPattern=8 4;verticalAlign=top;verticalLabelPosition=top;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="310" height="370" as="geometry" />
        </mxCell>

        <!-- H-Branch 内部节点 (parent = h_container, 相对坐标) -->
        <mxCell id="h_conv" value="1×k Conv + BN&#xa;(水平条带卷积)&#xa;→ [B, mid_c, H, W]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#333333;" vertex="1" parent="h_container">
          <mxGeometry x="25" y="45" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="h_pool" value="AdaptiveMaxPool2d&#xa;(H, 1) 水平条带池化&#xa;→ [B, mid_c, H, 1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;" vertex="1" parent="h_container">
          <mxGeometry x="25" y="130" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="h_sigmoid" value="Sigmoid&#xa;(生成水平注意力权重)&#xa;→ h_attention [B, mid_c, H, 1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;" vertex="1" parent="h_container">
          <mxGeometry x="25" y="215" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="h_repeat" value="repeat(1, 1, 1, W)&#xa;展开到全宽&#xa;→ h_expanded [B, mid_c, H, W]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#333333;" vertex="1" parent="h_container">
          <mxGeometry x="25" y="300" width="260" height="55" as="geometry" />
        </mxCell>

        <!-- H-Branch 内部连线 -->
        <mxCell id="h_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;" edge="1" parent="h_container" source="h_conv" target="h_pool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="h_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;" edge="1" parent="h_container" source="h_pool" target="h_sigmoid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="h_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;" edge="1" parent="h_container" source="h_sigmoid" target="h_repeat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== W方向条带注意力容器 ===== -->
        <mxCell id="w_container" value="W方向条带注意力 (Strip Attention W)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;fontColor=#333333;dashed=1;dashPattern=8 4;verticalAlign=top;verticalLabelPosition=top;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="140" width="310" height="370" as="geometry" />
        </mxCell>

        <!-- W-Branch 内部节点 (parent = w_container, 相对坐标) -->
        <mxCell id="w_conv" value="k×1 Conv + BN&#xa;(垂直条带卷积)&#xa;→ [B, mid_c, H, W]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#333333;" vertex="1" parent="w_container">
          <mxGeometry x="25" y="45" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="w_pool" value="AdaptiveMaxPool2d&#xa;(1, W) 垂直条带池化&#xa;→ [B, mid_c, 1, W]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;" vertex="1" parent="w_container">
          <mxGeometry x="25" y="130" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="w_sigmoid" value="Sigmoid&#xa;(生成垂直注意力权重)&#xa;→ w_attention [B, mid_c, 1, W]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#333333;" vertex="1" parent="w_container">
          <mxGeometry x="25" y="215" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="w_repeat" value="repeat(1, 1, H, 1)&#xa;展开到全高&#xa;→ w_expanded [B, mid_c, H, W]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#333333;" vertex="1" parent="w_container">
          <mxGeometry x="25" y="300" width="260" height="55" as="geometry" />
        </mxCell>

        <!-- W-Branch 内部连线 -->
        <mxCell id="w_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;" edge="1" parent="w_container" source="w_conv" target="w_pool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;" edge="1" parent="w_container" source="w_pool" target="w_sigmoid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;" edge="1" parent="w_container" source="w_sigmoid" target="w_repeat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 输入到两分支的连线 ===== -->
        <mxCell id="in_to_h" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;" edge="1" parent="1" source="input" target="h_conv">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="130" />
              <mxPoint x="225" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="in_to_w" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;" edge="1" parent="1" source="input" target="w_conv">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="130" />
              <mxPoint x="675" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== 拼接 (Concat) ===== -->
        <mxCell id="concat" value="torch.cat([h_expanded, w_expanded], dim=1)&#xa;→ [B, 2 × mid_c, H, W]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="260" y="550" width="380" height="55" as="geometry" />
        </mxCell>

        <!-- H-Repeat → Concat -->
        <mxCell id="hr_to_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="1" source="h_repeat" target="concat">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="530" />
              <mxPoint x="374" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- W-Repeat → Concat -->
        <mxCell id="wr_to_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="1" source="w_repeat" target="concat">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="675" y="530" />
              <mxPoint x="526" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== 融合 CBR ===== -->
        <mxCell id="fusion" value="1×1 Conv + BN + ReLU&#xa;(fusion_cbr 注意力融合)&#xa;→ fused_attention [B, mid_c, H, W]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="260" y="640" width="380" height="55" as="geometry" />
        </mxCell>

        <mxCell id="c_to_f" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="1" source="concat" target="fusion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Final CB + Sigmoid ===== -->
        <mxCell id="final_cb" value="1×1 Conv + BN + Sigmoid&#xa;(final_cb 生成最终注意力权重)&#xa;→ combined_attention [B, C, H, W]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="260" y="730" width="380" height="55" as="geometry" />
        </mxCell>

        <mxCell id="f_to_fc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="1" source="fusion" target="final_cb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 输出 ===== -->
        <mxCell id="output" value="output = identity × combined_attention&#xa;                    + identity × 0.1&#xa;→ [B, C, H, W]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="830" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fc_to_o" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="final_cb" target="output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Identity 残差连接 ===== -->
        <mxCell id="identity" value="identity = x&#xa;(保存输入副本)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontColor=#555555;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="55" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- Input → Identity -->
        <mxCell id="in_to_id" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#999999;dashed=1;" edge="1" parent="1" source="input" target="identity">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Identity → Output (残差连接) -->
        <mxCell id="id_to_o" value="残差连接 (×0.1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#999999;dashed=1;fontColor=#888888;fontSize=10;" edge="1" parent="1" source="identity" target="output">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="120" />
              <mxPoint x="860" y="848" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== 图例 ===== -->
        <mxCell id="legend" value="图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="70" y="550" width="150" height="130" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend">
          <mxGeometry x="10" y="25" width="25" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg1t" value="H方向分支" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="legend">
          <mxGeometry x="42" y="22" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="legend">
          <mxGeometry x="10" y="47" width="25" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg2t" value="W方向分支" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="legend">
          <mxGeometry x="42" y="44" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="legend">
          <mxGeometry x="10" y="69" width="25" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg3t" value="注意力/激活" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="legend">
          <mxGeometry x="42" y="66" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="legend">
          <mxGeometry x="10" y="91" width="25" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg4t" value="融合/合并" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" vertex="1" parent="legend">
          <mxGeometry x="42" y="88" width="100" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
